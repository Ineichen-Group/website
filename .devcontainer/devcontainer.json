{
  "name": "Quarto Website",
  "image": "rocker/r-ver:4.3.2",
  "features": {
    "ghcr.io/devcontainers/features/quarto:1": {}
  },
  "postCreateCommand": "R -e \"install.packages(c('tidyverse','leaflet','palmerpenguins'), repos='https://cloud.r-project.org')\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "REditorSupport.r"
      ]
    }
  },
  "forwardPorts": [4200]
}