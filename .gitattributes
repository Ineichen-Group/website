# Auto-detect text files and normalize to LF
* text=auto

# Force LF for common Quarto / web files
*.qmd text eol=lf
*.md text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.R text eol=lf

# Binary files (do not modify)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary